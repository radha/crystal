--- a/src/time/format/formatter.cr
+++ b/src/time/format/formatter.cr
@@ -254,9 +254,20 @@ struct Time::Format
       get_day_name[0, 3]
     end
 
+    # Concatenation of all two-digit decimal numbers from `00` to `99`. The
+    # zero-padded fixed-width fields below are always in `0..99` (`pad2`) or
+    # `0..9999` (`pad4`), so a single table lookup emits both digits without an
+    # `Int#to_s` call, its buffer setup, or a division.
+    private DIGIT_PAIRS = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"
+
     def pad2(value, padding) : Nil
-      io << padding if value < 10
-      io << value
+      if padding == '0' && value >= 0 && value < 100
+        i = value.to_i! &* 2
+        io.write_string DIGIT_PAIRS.to_slice[i, 2]
+      else
+        io << padding if value < 10
+        io << value
+      end
     end
 
     def pad3(value, padding) : Nil
@@ -265,8 +276,15 @@ struct Time::Format
     end
 
     def pad4(value, padding) : Nil
-      io << padding if value < 1000
-      pad3 value, padding
+      if padding == '0' && value >= 0 && value < 10000
+        v = value.to_i!
+        pairs = DIGIT_PAIRS.to_slice
+        io.write_string pairs[(v // 100) &* 2, 2]
+        io.write_string pairs[(v % 100) &* 2, 2]
+      else
+        io << padding if value < 1000
+        pad3 value, padding
+      end
     end
 
     def pad6(value, padding) : Nil
